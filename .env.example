# Environment Variables Template
NODE_ENV=development
PORT=3005

# Auth Secret for JWT signing
AUTH_SECRET=super-secret-ai-agency-key-change-in-prod-2026

# Database path (SQLite for local zero-config, or PostgreSQL connection string)
DATABASE_PATH=sqlite.db

# Google Gemini API Key for Real AI Chatbot (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Imposta a true se desideri forzare l'uso del fallback mock del chatbot
USE_MOCK_CHATBOT=false

# Motore Lead Generation Territoriale (100% Dati Aperti, OpenStreetMap & Overpass API - Licenza ODbL)
LEAD_PROVIDER=openstreetmap
USE_MOCK_LEAD_GEN=false
OSM_USER_AGENT=AI-Agency-CRM/1.0 (contact: info@ai-agency.it)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Configurazione Motore di Lead Enrichment Reale
ENRICHMENT_TIMEOUT_MS=8000
ENRICHMENT_MAX_SUBPAGES=4
ENRICHMENT_USER_AGENT=AI-Consulting-CRM-Bot/1.0 (+https://ai-agency.it/bot; privacy@ai-agency.it)
